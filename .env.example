# Vercel / stock Next.js: required server-only Neon PostgreSQL connection string.
# Obtain a Neon project, copy its pooled URL, and apply npm run db:migrate:postgres.
DATABASE_URL=
# Optional: curated answers and authored wit work without AI.
# AI can choose only an approved grounded sentence, never supply celebrity facts.
OPENAI_API_KEY=
# Public origin used only for metadata/social cards; no secrets in this value.
APP_URL=http://localhost:3000
# Local Cloudflare preview instead uses its provisioned D1 binding and .dev.vars.
# No realtime key: both deployments use authorized room polling.
